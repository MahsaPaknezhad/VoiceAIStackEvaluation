{
  "stt_service_id": "whisper_turbo",
  "stt_service_name": "Whisper Turbo (Local)",
  "module": "pipecat.services.whisper.stt",
  "class": "WhisperSTTService",
  "config": {
    "model": "turbo",
    "device": "auto",
    "compute_type": "int8",
    "language": "en",
    "no_speech_prob": 0.2
  },
  "requires_vad": true,
  "vad_config": {
    "module": "pipecat.audio.vad.silero",
    "class": "SileroVADAnalyzer",
    "config": {}
  },
  "audio_requirements": {
    "sample_rates": [8000, 16000],
    "resample_to": 16000
  },
  "aggregation_timeout": 3.0,
  "pipeline_timeout": 45.0
}
